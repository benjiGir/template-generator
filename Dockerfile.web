# ---- Build ----
FROM node:24-alpine AS builder
WORKDIR /app

# pnpm à la version fixée par le champ packageManager de package.json
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

# Workspace config
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./

# Package manifests only
COPY packages/shared/package.json packages/shared/
COPY packages/component-registry/package.json packages/component-registry/
# Le front lit le type des routes de l'API (client typé) : ses sources servent à la vérification des types
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/

RUN pnpm install --frozen-lockfile

# Sources
COPY packages/shared packages/shared
COPY packages/component-registry packages/component-registry
COPY apps/api/src apps/api/src
COPY apps/api/tsconfig.json apps/api/
COPY apps/web apps/web

# VITE_API_URL vide = URLs relatives proxifiées par nginx
ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}

# Build
RUN pnpm --filter @template-generator/web run build

# ---- Runtime ----
FROM nginx:alpine
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
